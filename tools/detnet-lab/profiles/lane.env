# Deterministic lane: a dedicated TCP link per hop for priority 1 (RealTime),
# marked DSCP EF (TOS 0xb8), and a prio qdisc on the bottleneck that serves EF
# first. Links are opened downstream (r1 -> r2 -> r3) so the sockets carrying
# probe traffic are the ones that set the TOS byte.
ROUTER_ARGS="--cfg=transport/unicast/max_links:4"
R1_CONNECT="tcp/10.12.0.2:7447?prio=1-1#dscp=0xb8 tcp/10.12.0.2:7447?prio=2-7"
R2_CONNECT="tcp/10.23.0.3:7447?prio=1-1#dscp=0xb8 tcp/10.23.0.3:7447?prio=2-7"
R3_CONNECT=""
QDISC=prio
PROBE_ARGS="--prio 1 --express --congestion drop"
CROSS_ARGS="--prio 5 --congestion block"
